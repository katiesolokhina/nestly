<%- include('partials/top', { title: 'Today' }) %>
<main class="stack">
  <div class="head">
    <div><p class="muted small"><%= date %></p><h1><%= greeting %></h1><p class="sub"><%= summary %></p></div>
    <a class="btn btn-ghost" href="/customize">Customize</a>
  </div>
  <% if (isAdmin && household.setupStep > 0) { %>
    <a class="card row menu-row setup-card" href="/setup"><span class="row-body"><span class="row-title">Finish setting up <%= household.name %></span><span class="row-meta">Sections, people, staples, and chores. A few minutes.</span></span><span class="chev" aria-hidden="true">›</span></a>
  <% } %>
  <div class="dash">
    <% widgets.forEach((w) => { %>
      <% if (w.kind === 'Tile') { const t = tiles[w.k]; %>
        <a class="tile" href="<%= t.href %>"><span class="tile-num"><%= t.num %></span><span class="tile-label"><%= t.label %></span></a>
      <% } else if (w.k === 'attention') { %>
        <section class="card full">
          <h2>Needs attention today</h2>
          <% if (!attention.length) { %><p class="muted small center">You're all caught up for today.</p><% } %>
          <% attention.forEach((a) => { %>
            <div class="row">
              <% if (a.color) { %><span class="cat-dot" style="background:<%= a.color %>" aria-hidden="true"></span><% } %>
              <% if (a.checkAction && (!a.section || canEdit(a.section))) { %><form method="post" action="<%= a.checkAction %>"><input type="hidden" name="from" value="today"><button class="check" type="submit" aria-label="<%= a.checkLabel %>"><i></i></button></form><% } %>
              <a class="row-body row-link" href="<%= a.href %>"><span class="row-title"><%= a.title %></span><span class="row-meta<%= a.late ? ' late' : '' %>"><%= a.meta %></span></a>
              <span class="tag"><%= a.type %></span>
            </div>
          <% }) %>
        </section>
      <% } else if (w.k === 'meals') { %>
        <section class="card full">
          <div class="row-h"><h2>Today’s meals</h2><a class="link-btn" href="/s/meals">Plan</a></div>
          <% if (!meals.length) { %><p class="muted small center">Nothing planned today. <a href="/s/meals/new">Plan a meal</a></p><% } %>
          <% meals.forEach((m) => { %>
            <div class="row meal-row"><span class="meal-slot"><%= m.slot %></span><a class="row-body row-link" href="<%= m.href %>"><span class="row-title"><%= m.title %></span><% if (m.note) { %><span class="row-meta"><%= m.note %></span><% } %></a></div>
          <% }) %>
        </section>
      <% } else if (w.k === 'upcoming') { %>
        <section class="card full">
          <h2>Coming up</h2>
          <% if (!upcoming.length) { %><p class="muted small center">Nothing in the next two weeks.</p><% } %>
          <% upcoming.forEach((u) => { %><div class="row"><% if (u.color) { %><span class="cat-dot" style="background:<%= u.color %>" aria-hidden="true"></span><% } %><div class="row-body"><span class="row-title"><%= u.title %></span><span class="row-meta"><%= u.meta %></span></div><span class="tag<%= u.lilac ? ' lilac' : '' %>"><%= u.tag %></span></div><% }) %>
        </section>
      <% } %>
    <% }) %>
  </div>
  <% if (!widgets.length) { %><p class="muted small center">Your dashboard is empty. Use Customize to add cards and tiles.</p><% } %>
</main>
<%- include('partials/bottom') %>
