<%- include('partials/top', { title: 'Categories and lists', scripts: ['color-submit'] }) %>
<main class="stack">
  <div class="head"><div><h1>Categories and lists</h1><p class="sub">Changes apply to the whole household.</p></div><a class="link-btn" href="/settings">Back</a></div>
  <% lists.forEach((l) => { %>
    <section class="card" id="<%= l.key %>">
      <h2><%= l.title %></h2>
      <% l.values.forEach((v, i) => { %>
        <div class="list-row">
          <form class="rename" method="post" action="/settings/lists/<%= l.key %>"><input type="hidden" name="value" value="<%= v %>"><input type="text" name="name" maxlength="40" value="<%= v %>" aria-label="Rename <%= v %>"><button class="link-btn" type="submit" name="action" value="rename">Save<span class="sr-only"> <%= v %></span></button></form>
          <form class="list-actions" method="post" action="/settings/lists/<%= l.key %>"><input type="hidden" name="value" value="<%= v %>">
            <% if (l.key === 'eventCats') { %><label class="color-pick"><span class="sr-only">Color for <%= v %></span><input type="color" name="color" value="<%= colorOf(v) %>" data-color-submit></label><button class="link-btn" type="submit" name="action" value="color" data-color-save>Save color<span class="sr-only"> for <%= v %></span></button><% } %>
            <button class="mini" type="submit" name="action" value="up" aria-label="Move <%= v %> up"<%= i === 0 ? ' disabled' : '' %>>↑</button>
            <button class="mini" type="submit" name="action" value="down" aria-label="Move <%= v %> down"<%= i === l.values.length - 1 ? ' disabled' : '' %>>↓</button>
            <button class="link-btn link-danger" type="submit" name="action" value="remove">Remove<span class="sr-only"> <%= v %></span></button>
          </form>
        </div>
      <% }) %>
      <p class="hint">Removing one moves its items to <%= l.fallback %>.<% if (l.key === 'eventCats') { %> Tap a color to change it. Uncategorized events are gray.<% } %></p>
      <form class="add" method="post" action="/settings/lists/<%= l.key %>"><input type="text" name="name" maxlength="40" aria-label="Add a <%= l.one %>" placeholder="Add a <%= l.one %>"><button class="btn btn-primary" type="submit" name="action" value="add">Add</button></form>
    </section>
  <% }) %>
</main>
<%- include('partials/bottom') %>
