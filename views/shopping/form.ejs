<%- include('../partials/top', { title: item._id ? 'Edit item' : 'Add item' }) %>
<main class="stack">
  <div class="head"><h1><%= item._id ? 'Edit item' : 'Add item' %></h1><a class="link-btn" href="/s/shopping">Cancel</a></div>
  <form class="card" method="post" action="/s/shopping<%= item._id ? '/' + item._id : '' %>" enctype="multipart/form-data" novalidate>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <div class="field"><label for="name">Item</label><input id="name" name="name" type="text" list="catalog-names" maxlength="80" required value="<%= item.name %>"></div>
    <datalist id="catalog-names"><% catalog.forEach((c) => { %><option value="<%= c.name %>"></option><% }) %></datalist>
    <div class="fields">
      <div class="field"><label for="qty">Quantity</label><input id="qty" name="qty" type="text" maxlength="30" value="<%= item.qty %>"></div>
      <div class="field"><label for="price">Price</label><input id="price" name="price" type="text" inputmode="decimal" placeholder="0.00" value="<%= item.price ?? '' %>"></div>
    </div>
    <% if (lastPaid) { %><p class="hint"><%= lastPaid %></p><% } %>
    <div class="field" id="receipt">
      <label for="receiptFile">Receipt</label>
      <% if (receipt) { %><p class="file-row"><% if (receipt.type.startsWith('image/')) { %><img class="file-thumb" src="/files/<%= receipt._id %>" alt=""><% } %><a href="/files/<%= receipt._id %>/view?back=/s/shopping/<%= item._id %>/edit"><%= receipt.name %></a><label class="inline-check"><input type="checkbox" name="removeReceipt">Remove</label></p><% } %>
      <input id="receiptFile" name="receipt" type="file" accept="image/*,.pdf">
      <span class="hint">A photo or PDF, up to 10 MB.</span>
    </div>
    <div class="field">
      <label for="photoFile">Reference photo</label>
      <% if (photo) { %><p class="file-row"><a href="/files/<%= photo._id %>/view?back=/s/shopping/<%= item._id %>/edit"><img class="file-thumb" src="/files/<%= photo._id %>" alt=""></a><a href="/files/<%= photo._id %>/view?back=/s/shopping/<%= item._id %>/edit"><%= photo.name %></a><label class="inline-check"><input type="checkbox" name="removePhoto">Remove</label></p><% } %>
      <input id="photoFile" name="photo" type="file" accept="image/*">
    </div>
    <div class="fields">
      <div class="field"><label for="method">Buying</label><select id="method" name="method"><% [...new Set([...household.methods, item.method].filter(Boolean))].forEach((m) => { %><option<%= item.method === m ? ' selected' : '' %>><%= m %></option><% }) %></select></div>
      <div class="field"><label for="store">Store</label><select id="store" name="store"><option>Any store</option><% household.stores.forEach((s) => { %><option<%= item.store === s ? ' selected' : '' %>><%= s %></option><% }) %></select></div>
    </div>
    <div class="fields">
      <div class="field"><label for="aisle">Aisle</label><select id="aisle" name="aisle"><option>Unassigned</option><% household.aisles.forEach((s) => { %><option<%= item.aisle === s ? ' selected' : '' %>><%= s %></option><% }) %></select></div>
      <div class="field"><label for="tag">Tag</label><select id="tag" name="tag"><option>Unassigned</option><% household.tags.forEach((s) => { %><option<%= item.tag === s ? ' selected' : '' %>><%= s %></option><% }) %></select></div>
    </div>
    <div class="field"><label for="brand">Brand</label><input id="brand" name="brand" type="text" maxlength="80" value="<%= item.brand %>"></div>
    <div class="field"><label for="ref">Reference item</label><input id="ref" name="ref" type="text" maxlength="160" placeholder="Size, model, or what to look for" value="<%= item.ref %>"></div>
    <div class="field"><label for="link">Product link</label><input id="link" name="link" type="text" inputmode="url" maxlength="1000" placeholder="https://..." value="<%= item.link %>"></div>
    <div class="field"><label for="note">Note</label><input id="note" name="note" type="text" maxlength="300" value="<%= item.note %>"></div>
    <input type="hidden" name="stapleShown" value="1"><label class="check-row">Save as a staple<input type="checkbox" name="staple"<%= item.staple ? ' checked' : '' %>></label>
<% if (perms.private) { %>    <% if (!item._id || String(item.createdBy) === user.id) { %><label class="check-row">Only me<input type="checkbox" name="private"<%= item.private ? ' checked' : '' %>></label><% } %><% } %>
    <button class="btn btn-primary btn-block" type="submit">Save</button>
  </form>
  <% if (item._id && can('shopping', 'delete', item)) { %><form method="post" action="/s/shopping/<%= item._id %>/delete"><button class="link-btn link-danger" type="submit">Delete<span class="sr-only"> <%= item.name %></span></button></form><% } %>
</main>
<%- include('../partials/bottom') %>
