<%- include('../partials/top', { title: 'Shopping', scripts: ['auto-submit', 'select-all', 'swipe', 'quick', 'scan'] }) %>
<main class="stack">
  <% if (selecting) { %>
    <div class="head"><div><h1>Select items</h1><p class="sub">Delete them from the list without marking them bought.</p></div><a class="link-btn" href="/s/shopping<%= query ? '?' + query : '' %>">Cancel</a></div>
    <% if (!groups.length) { %><div class="card"><p class="muted small center">Nothing on the list.</p></div><% } else { %>
    <form class="stack" method="post" action="/s/shopping/delete-many" data-select-form>
      <input type="hidden" name="query" value="<%= query %>">
      <div class="card">
        <label class="row ing-pick select-all"><input type="checkbox" data-select-all><span class="row-body"><span class="row-title">Select all</span></span></label>
        <% groups.forEach((g) => { %>
          <p class="aisle"><%= g.name %></p>
          <% g.items.forEach((i) => { %>
            <label class="row ing-pick"><input type="checkbox" name="ids" value="<%= i._id %>" data-select-item><span class="row-body"><span class="row-title"><%= i.name %></span><span class="row-meta"><%= i.meta %></span></span><span class="tag"><%= i.qty %></span></label>
          <% }) %>
        <% }) %>
      </div>
      <button class="btn btn-danger btn-block" type="submit" data-select-count>Delete selected</button>
    </form>
    <% } %>
  <% } else if (shopping) { %>
    <div class="notice shop-bar"><span><strong>Shopping<%= store ? ' at ' + store : '' %>.</strong> <span data-count="<%= count %>" data-one="item" data-many="items"><%= count %> <%= count === 1 ? 'item' : 'items' %></span> left.</span><span class="btn-row"><% if (canEdit('shopping')) { %><button class="btn btn-ghost" type="button" data-scan-open hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 7V4h3M21 7V4h-3M3 17v3h3M21 17v3h-3M7 8v8M10 8v8M13 8v8M17 8v8"></path></svg> Scan</button><% } %><a class="link-btn" href="/s/shopping<%= query ? '?' + query : '' %>">Finish</a></span></div>
  <% } else { %>
    <div class="head"><div><h1 class="title-gear"><%= secName('shopping') %><%- include('../partials/gear', { key: 'shopping' }) %></h1><p class="sub"><span data-count="<%= count %>" data-one="item" data-many="items"><%= count %> <%= count === 1 ? 'item' : 'items' %></span> · About <%= total %></p></div><% if (can('shopping', 'shop')) { %><form method="post" action="/s/shopping/start"><input type="hidden" name="query" value="<%= query %>"><input type="hidden" name="store" value="<%= store %>"><button class="btn btn-ghost" type="submit">Start shopping</button></form><% } %></div>
    <% if (household.tripAlerts !== false && can('shopping', 'shop')) { %><p class="hint">Start shopping lets everyone else know<%= store ? ' you’re at ' + store : '' %>, so they can add what they need. <a href="/s/shopping?<%= query ? query + '&' : '' %>mode=shop">Shop without telling anyone</a></p><% } %>
    <form class="stack" method="get" action="/s/shopping" data-auto-submit>
      <div class="fields">
        <div class="field"><label for="method">Buying</label><select id="method" name="method"><% ['All', ...methods].forEach((m) => { %><option value="<%= m === 'All' ? '' : m %>"<%= method === m ? ' selected' : '' %>><%= m %></option><% }) %></select></div>
        <div class="field"><label for="store">Store</label><select id="store" name="store"><option value="">All stores</option><% household.stores.forEach((s) => { %><option<%= store === s ? ' selected' : '' %>><%= s %></option><% }) %></select></div>
        <div class="field"><label for="tag">Tag</label><select id="tag" name="tag"><option value="">All tags</option><% household.tags.forEach((s) => { %><option<%= tag === s ? ' selected' : '' %>><%= s %></option><% }) %></select></div>
      </div>
      <button class="btn btn-ghost" type="submit">Filter</button>
    </form>
    <% if (can('shopping', 'add')) { %><form class="add" method="post" action="/s/shopping/quick">
      <input type="hidden" name="query" value="<%= query %>">
      <input type="text" name="name" list="catalog-names" maxlength="80" aria-label="Add an item" placeholder="Add an item" autocomplete="off">
      <button class="btn btn-primary" type="submit">Add</button>
      <a class="btn btn-ghost" href="/s/shopping/new">Details</a>
    </form>
    <button class="btn btn-ghost scan-btn" type="button" data-scan-open hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 7V4h3M21 7V4h-3M3 17v3h3M21 17v3h-3M7 8v8M10 8v8M13 8v8M17 8v8"></path></svg> Scan a barcode to add</button><% } %>
    <datalist id="catalog-names"><% catalog.forEach((c) => { %><option value="<%= c.name %>"></option><% }) %></datalist>
    <% if (!staples.length && can('shopping', 'saved') && catalog.length) { %><a class="link-btn saved-link" href="/s/shopping/saved">Saved items and staples</a><% } %>
    <% if (staples.length) { %>
      <div><div class="row-h"><p class="aisle">Staples: tap to add</p><% if (can('shopping', 'saved')) { %><a class="link-btn" href="/s/shopping/saved">Edit</a><% } %></div><div class="staples"><% staples.forEach((s) => { %><form method="post" action="/s/shopping/quick"><input type="hidden" name="name" value="<%= s.name %>"><input type="hidden" name="query" value="<%= query %>"><button class="staple" type="submit">+ <%= s.name %></button></form><% }) %></div></div>
    <% } %>
  <% } %>
  <% if (!selecting) { %>
  <% if (count && !shopping) { %>
    <div class="row-h list-tools"><span class="aisle">On the list</span><a class="link-btn" href="/s/shopping?<%= query ? query + '&' : '' %>select=1">Select to delete</a></div>
  <% } %>
  <div class="card" data-list>
    <% if (!groups.length) { %><p class="muted small center empty-note">Nothing here right now.</p><% } %>
    <% groups.forEach((g) => { %>
      <div data-group>
        <p class="aisle"><%= g.name %></p>
        <% g.items.forEach((i) => { %>
          <% const back = query + (shopping ? (query ? '&' : '') + 'mode=shop' : ''); %>
          <div class="swipe" data-swipe>
          <% if (can('shopping', 'delete', i)) { %><form class="swipe-delete" method="post" action="/s/shopping/<%= i._id %>/delete" data-quick="remove"><input type="hidden" name="query" value="<%= back %>"><button type="submit" tabindex="-1">Delete<span class="sr-only"> <%= i.name %></span></button></form><% } %>
          <div class="row<%= shopping ? ' big' : '' %>">
            <% if (!can('shopping', 'check')) { %><span class="check-gap" aria-hidden="true"></span><% } else { %><form method="post" action="/s/shopping/<%= i._id %>/toggle" data-quick="bought"><input type="hidden" name="bought" value="1"><input type="hidden" name="query" value="<%= query %><%= shopping ? (query ? '&' : '') + 'mode=shop' : '' %>"><button class="check" type="submit" aria-label="Mark <%= i.name %> bought"><i></i></button></form><% } %>
            <a class="row-body row-link" href="/s/shopping/<%= i._id %>/edit" aria-label="Edit <%= i.name %>"><span class="row-title"><%= i.name %></span><span class="row-meta"><%= i.meta %></span></a>
            <% if (i.private) { %><span class="tag lilac">Only me</span><% } %>
            <% if (i.link) { %><a class="link-btn" href="<%= i.link %>" target="_blank" rel="noopener noreferrer">Buy<span class="sr-only"> <%= i.name %></span></a><% } %>
            <span class="tag"><%= i.qty %></span>
          </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
  <% if (groups.length && !shopping) { %><p class="hint">Swipe an item left to delete it.</p><% } %>
    <div class="card" id="bought-card"<%= bought.length ? '' : ' hidden' %>>
      <div class="row-h"><h2>Bought</h2><% if (can('shopping', 'delete') && (!perms.custom('shopping') || perms.custom('shopping').delete === 'all')) { %><form method="post" action="/s/shopping/clear"><input type="hidden" name="query" value="<%= query %>"><button class="link-btn" type="submit">Clear</button></form><% } %></div>
      <div data-bought-list>
      <% bought.forEach((i) => { %>
        <div class="row done">
          <% if (can('shopping', 'check')) { %><form method="post" action="/s/shopping/<%= i._id %>/toggle"><input type="hidden" name="bought" value="0"><input type="hidden" name="query" value="<%= query %>"><button class="check on" type="submit" aria-label="Move <%= i.name %> back to the list"><i>✓</i></button></form><% } %>
          <a class="row-body row-link" href="/s/shopping/<%= i._id %>/edit" aria-label="Edit <%= i.name %>"><span class="row-title"><%= i.name %></span><span class="row-meta"><%= i.meta %></span></a>
          <% if (i.receiptId) { %><a class="link-btn" href="/files/<%= i.receiptId %>/view?back=/s/shopping">View receipt<span class="sr-only"> for <%= i.name %></span></a><% } else { %><a class="link-btn" href="/s/shopping/<%= i._id %>/edit#receipt">Add receipt<span class="sr-only"> for <%= i.name %></span></a><% } %>
        </div>
      <% }) %>
      </div>
    </div>
    <template id="bought-row"><div class="row done"><form method="post" action=""><input type="hidden" name="bought" value="0"><input type="hidden" name="query" value="<%= query %>"><button class="check on" type="submit"><i>✓</i></button></form><a class="row-body row-link" href="" data-edit><span class="row-title"></span><span class="row-meta"></span></a><a class="link-btn" href="" data-receipt>Add receipt</a></div></template>
  <% } %>
</main>
<% if (!selecting && canEdit('shopping')) { %><%- include('../partials/scanner', { mode: shopping ? 'shop' : 'shopping', query }) %><% } %>
<%- include('../partials/bottom') %>
