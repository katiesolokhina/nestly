<%- include('../partials/top', { title: item._id ? 'Edit event' : 'Add event', scripts: ['event-form', 'confirm'] }) %>
<main class="stack">
  <div class="head"><h1><%= item._id ? 'Edit event' : 'Add event' %></h1><a class="link-btn" href="<%= item._id ? '/s/calendar/' + item._id : '/s/calendar?day=' + item.date %>">Cancel</a></div>
  <form class="card" method="post" action="/s/calendar<%= item._id ? '/' + item._id : '' %>" enctype="multipart/form-data" novalidate data-event-form>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <div class="field"><label for="title">Event</label><input id="title" name="title" type="text" maxlength="120" required value="<%= item.title %>"></div>
    <div class="fields">
      <div class="field"><label for="date">Starts</label><input id="date" name="date" type="date" required value="<%= item.date %>" data-start-date></div>
      <div class="field"><label for="endDate">Ends</label><input id="endDate" name="endDate" type="date" min="<%= item.date %>" value="<%= item.endDate || item.date %>" data-end-date></div>
    </div>
    <label class="check-row">All day<input type="checkbox" name="allDay" data-all-day<%= item._id && !item.time ? ' checked' : '' %>></label>
    <div class="fields" data-times>
      <div class="field"><label for="time">Start time</label><input id="time" name="time" type="time" value="<%= item.time %>"></div>
      <div class="field"><label for="endTime">End time</label><input id="endTime" name="endTime" type="time" value="<%= item.endTime %>"></div>
    </div>
    <div class="field"><label for="location">Location</label><input id="location" name="location" type="text" maxlength="200" placeholder="Address or place" value="<%= item.location %>"></div>

    <fieldset class="group">
      <legend>Repeats</legend>
      <div class="fields">
        <div class="field"><label for="repeat">How often</label><select id="repeat" name="repeat" data-repeat>
          <% [['none', 'Does not repeat'], ['daily', 'Daily'], ['weekly', 'Weekly'], ['monthly', 'Monthly'], ['yearly', 'Yearly']].forEach(([v, l]) => { %><option value="<%= v %>"<%= item.repeat === v ? ' selected' : '' %>><%= l %></option><% }) %>
        </select></div>
        <div class="field" data-repeat-only><label for="interval">Every</label><input id="interval" name="interval" type="number" min="1" max="99" inputmode="numeric" value="<%= item.interval || 1 %>"><span class="hint" data-unit>1 = every time, 2 = every other</span></div>
      </div>
      <div class="field" data-weekly-only>
        <span class="label">On these days</span>
        <span class="hint">Leave blank to repeat on the same weekday as the start date.</span>
        <div class="weekdays">
          <% dayNames.forEach((n, i) => { %><label class="weekday"><input type="checkbox" name="days" value="<%= i %>"<%= (item.days || []).includes(i) ? ' checked' : '' %>><span><%= n %></span></label><% }) %>
        </div>
      </div>
      <div class="field" data-repeat-only><label for="until">Repeat until <span class="muted">(optional)</span></label><input id="until" name="until" type="date" value="<%= item.until %>"></div>
      <% if (item._id && item.repeat !== 'none') { %><p class="hint">Changes apply to every time this event repeats.</p><% } %>
    </fieldset>

    <div class="fields">
      <div class="field"><label for="category">Category</label><select id="category" name="category"><option<%= item.category === 'Uncategorized' ? ' selected' : '' %>>Uncategorized</option><% household.eventCats.forEach((c) => { %><option<%= item.category === c ? ' selected' : '' %>><%= c %></option><% }) %></select></div>
    </div>
    <div class="field"><label for="link">Link <span class="muted">(tickets, RSVP, details)</span></label><input id="link" name="link" type="text" inputmode="url" maxlength="1000" placeholder="https://..." value="<%= item.link %>"></div>
    <div class="field">
      <label for="file">File <span class="muted">(tickets, invitation)</span></label>
      <% if (file) { %><p class="file-row"><% if (file.type.startsWith('image/')) { %><img class="file-thumb" src="/files/<%= file._id %>" alt=""><% } %><a href="/files/<%= file._id %>/view?back=/s/calendar/<%= item._id %>/edit"><%= file.name %></a><label class="inline-check"><input type="checkbox" name="removeFile">Remove</label></p><% } %>
      <input id="file" name="file" type="file" accept="image/*,.pdf">
      <span class="hint">A photo or PDF, up to 10 MB.</span>
    </div>
    <div class="field"><label for="details">Details</label><textarea id="details" name="details" maxlength="1000" rows="3"><%= item.details %></textarea></div>
    <% if (!item._id || String(item.createdBy) === user.id) { %><label class="check-row">Only me<input type="checkbox" name="private"<%= item.private ? ' checked' : '' %>></label><% } %>
    <button class="btn btn-primary btn-block" type="submit">Save</button>
  </form>
  <% if (item._id) { %><form method="post" action="/s/calendar/<%= item._id %>/delete" data-confirm="<%= item.repeat !== 'none' ? 'Delete every time this event repeats?' : 'Delete this event?' %>"><button class="link-btn link-danger" type="submit">Delete<%= item.repeat !== 'none' ? ' all repeats' : '' %><span class="sr-only"> of <%= item.title %></span></button></form><% } %>
</main>
<%- include('../partials/bottom') %>
