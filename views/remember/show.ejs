<%- include('../partials/top', { title: item.text }) %>
<main class="stack">
  <div class="head"><div><h1><%= item.text %></h1><p class="sub"><%= when %></p></div><a class="link-btn" href="/s/remember">Back</a></div>
  <% if (snoozedText) { %><p class="notice" role="status"><%= snoozedText %></p><% } %>
  <div class="card">
    <% if (item.details) { %><div class="row"><div class="row-body"><span class="row-meta">Details</span><span class="details-text"><%= item.details %></span></div></div><% } %>
    <div class="row"><div class="row-body"><span class="row-meta">Notifies</span><span class="row-title"><%= notifies %></span></div><% if (item.private) { %><span class="tag lilac">Only me</span><% } %></div>
    <% if (item.category !== 'Uncategorized') { %><div class="row"><div class="row-body"><span class="row-meta">Category</span><span class="row-title"><%= item.category %></span></div></div><% } %>
    <div class="row"><div class="row-body"><span class="row-meta">Added by</span><span class="row-title"><%= item.byName %></span></div></div>
  </div>

  <% if (item.done) { %>
    <p class="notice">This one’s checked off.</p>
  <% } else { %>
    <form method="post" action="/s/remember/<%= item._id %>/done"><input type="hidden" name="from" value="view"><button class="btn btn-primary btn-block" type="submit">Done</button></form>
    <section class="card" aria-labelledby="snooze">
      <h2 id="snooze">Snooze</h2>
      <p class="row-meta">Notifies just you again. Everyone else is left alone.</p>
      <div class="snooze-grid">
        <% [['10', '10 min'], ['30', '30 min'], ['60', '1 hour'], ['180', '3 hours']].forEach(([m, l]) => { %>
          <form method="post" action="/s/remember/<%= item._id %>/snooze"><input type="hidden" name="minutes" value="<%= m %>"><button class="btn btn-ghost btn-block" type="submit"><%= l %></button></form>
        <% }) %>
      </div>
      <form method="post" action="/s/remember/<%= item._id %>/snooze"><input type="hidden" name="minutes" value="morning"><button class="btn btn-ghost btn-block" type="submit">Tomorrow morning (<%= morning %>)</button></form>
      <form class="add" method="post" action="/s/remember/<%= item._id %>/snooze">
        <label class="sr-only" for="minutes">Snooze for how many minutes</label>
        <input id="minutes" name="minutes" type="number" min="1" max="1440" inputmode="numeric" placeholder="Other: minutes" required>
        <button class="btn btn-ghost" type="submit">Snooze</button>
      </form>
    </section>
  <% } %>
  <% if (can('remember', 'edit', item)) { %><a class="btn btn-ghost btn-block" href="/s/remember/<%= item._id %>/edit">Edit reminder</a><% } %>
</main>
<%- include('../partials/bottom') %>
