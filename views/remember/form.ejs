<%- include('../partials/top', { title: item._id ? 'Edit reminder' : 'Add reminder' }) %>
<main class="stack">
  <div class="head"><h1><%= item._id ? 'Edit reminder' : 'Add reminder' %></h1><a class="link-btn" href="/s/remember">Cancel</a></div>
  <form class="card" method="post" action="/s/remember<%= item._id ? '/' + item._id : '' %>" novalidate>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <div class="field"><label for="text">What to remember</label><input id="text" name="text" type="text" maxlength="160" required value="<%= item.text %>"></div>
    <div class="field"><label for="details">Details</label><textarea id="details" name="details" maxlength="1000" rows="3" placeholder="Anything else that helps"><%= item.details %></textarea></div>
    <div class="fields">
      <div class="field"><label for="date">Remind on</label><input id="date" name="date" type="date" value="<%= item.date %>"></div>
      <div class="field"><label for="category">Category</label><select id="category" name="category"><% household.remCats.forEach((c) => { %><option<%= item.category === c ? ' selected' : '' %>><%= c %></option><% }) %><option<%= item.category === 'Uncategorized' ? ' selected' : '' %>>Uncategorized</option></select></div>
    </div>
    <% if (!item._id || String(item.createdBy) === user.id) { %><label class="check-row">Only me<input type="checkbox" name="private"<%= item.private ? ' checked' : '' %>></label><% } %>
    <button class="btn btn-primary btn-block" type="submit">Save</button>
  </form>
  <% if (item._id) { %><form method="post" action="/s/remember/<%= item._id %>/delete"><button class="link-btn link-danger" type="submit">Delete<span class="sr-only"> <%= item.text %></span></button></form><% } %>
</main>
<%- include('../partials/bottom') %>
