<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title><%= heading %> · Nestly</title>
</head>
<body>
<main class="error-page">
  <a class="brand" href="/"><img src="/brand/nestly-mark.png" width="48" height="48" alt="">nestly</a>
  <p class="error-code"><%= code %></p>
  <h1><%= heading %></h1>
  <p class="sub"><%= message %></p>
  <div class="btn-row center">
    <a class="btn btn-primary" href="/">Go to Today</a>
    <% if (back) { %><a class="btn btn-ghost" href="<%= back %>">Go back</a><% } %>
  </div>
  <% if (report) { %><p class="small muted">Keeps happening? <a href="/feedback?kind=bug&from=<%= encodeURIComponent(path) %>">Report it</a>.</p><% } %>
</main>
</body>
</html>
