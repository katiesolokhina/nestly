<%- include('../partials/top', { title: 'Import a recipe' }) %>
<main class="stack">
  <div class="head"><div><h1>Import a recipe</h1><p class="sub">You'll check everything before it's saved.</p></div><a class="link-btn" href="/s/recipes">Cancel</a></div>
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form class="card" method="post" action="/s/recipes/import">
    <h2>From a link</h2>
    <input type="hidden" name="mode" value="link">
    <div class="field"><label for="link">Recipe page</label><input id="link" name="link" type="text" inputmode="url" maxlength="1000" placeholder="https://..." value="<%= link %>" required></div>
    <button class="btn btn-primary btn-block" type="submit">Get recipe</button>
    <p class="hint">Works with most recipe sites. If one doesn't, paste the recipe below.</p>
  </form>
  <form class="card" method="post" action="/s/recipes/import">
    <h2>Paste the text</h2>
    <input type="hidden" name="mode" value="text">
    <div class="field"><label for="text">Recipe</label><textarea id="text" name="text" rows="10" maxlength="20000" placeholder="Name&#10;Ingredients&#10;2 cups flour&#10;...&#10;Instructions&#10;1. Mix...&#10;"><%= text %></textarea></div>
    <button class="btn btn-ghost btn-block" type="submit">Read recipe</button>
    <p class="hint">Headings like “Ingredients” and “Instructions” help it split things up.</p>
  </form>
</main>
<%- include('../partials/bottom') %>
