<%- include('partials/top', { title: target.name, scripts: ['confirm'] }) %>
<main class="stack">
  <div class="head"><div><h1><%= target.name %></h1><p class="sub"><%= target.email %><%= target.disabled ? ' · Turned off' : '' %></p></div><a class="link-btn" href="/settings#household">Back</a></div>
  <form class="card" method="post" action="/settings/household/members/<%= target._id %>/role">
    <div class="field"><label for="role">Role</label><select id="role" name="role"><option value="member"<%= target.role === 'member' ? ' selected' : '' %>>Member</option><option value="admin"<%= target.role === 'admin' ? ' selected' : '' %>>Admin</option></select></div>
    <button class="btn btn-ghost" type="submit">Save role</button>
  </form>
  <div class="card">
    <h2>Sign-in</h2>
    <% if (!target.disabled) { %>
      <p class="row-meta">Forgot their password? Create a one-time link and send it to them. Admins never see passwords.</p>
      <form method="post" action="/settings/household/members/<%= target._id %>/reset"><button class="btn btn-ghost btn-block" type="submit">Create a one-time reset link</button></form>
      <form method="post" action="/settings/household/members/<%= target._id %>/disable" data-confirm="Turn off <%= target.name %>'s account? They'll be signed out and can't sign in until you turn it back on."><button class="btn btn-ghost btn-block" type="submit">Turn off sign-in</button></form>
    <% } else { %>
      <form method="post" action="/settings/household/members/<%= target._id %>/enable"><button class="btn btn-ghost btn-block" type="submit">Turn sign-in back on</button></form>
    <% } %>
    <a class="link-btn link-danger" href="/settings/household/members/<%= target._id %>/delete">Delete account</a>
  </div>
</main>
<%- include('partials/bottom') %>
