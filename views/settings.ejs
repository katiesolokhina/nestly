<%- include('partials/top', { title: 'Settings', scripts: ['share-link', 'confirm', 'push-setup'] }) %>
<main class="stack">
  <h1>Settings</h1>
  <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>

  <section class="card" aria-labelledby="acct">
    <h2 id="acct">Account</h2>
    <p class="row-meta">Signed in as <%= user.email %></p>
    <a class="btn btn-ghost" href="/settings/account">Password and sign out</a>
  </section>

  <section class="card" id="notifications" aria-labelledby="notif">
    <h2 id="notif">Notifications</h2>
    <div id="push-card" hidden aria-live="polite">
      <div data-state="off" hidden>
        <p class="push-title">Off on this device</p>
        <p class="row-meta">Turn on each phone or computer you want notifications on.</p>
        <button class="btn btn-primary" type="button" data-action="enable">Turn on notifications</button>
      </div>
      <div data-state="on" hidden>
        <p class="push-title">On for this device</p>
        <p class="row-meta">Each phone or computer is set up separately.</p>
        <div class="push-actions">
          <button class="link-btn" type="button" data-action="test">Send a test</button>
          <button class="link-btn link-danger" type="button" data-action="disable">Turn off on this device</button>
        </div>
      </div>
      <div data-state="blocked" hidden>
        <p class="push-title">Blocked on this device</p>
        <p class="row-meta">Nestly isn’t allowed to notify you here. Allow notifications for Nestly in your phone’s or browser’s settings, then reopen the app.</p>
      </div>
      <p class="row-meta" data-status></p>
    </div>
    <p class="row-meta" data-push-unsupported>This browser can’t show notifications. On iPhone, add Nestly to your Home Screen (Share, then Add to Home Screen), open it from there, and come back here.</p>

    <form class="stack notify-prefs" method="post" action="/settings/notifications">
      <p class="row-meta">These choices are just for you.</p>
      <label class="check-row">Reminders<input type="checkbox" name="reminders"<%= user.notify.reminders !== false ? ' checked' : '' %>></label>
      <label class="check-row">Events<input type="checkbox" name="events"<%= user.notify.events !== false ? ' checked' : '' %>></label>
      <label class="check-row">When someone starts shopping<input type="checkbox" name="shopping"<%= user.notify.shopping !== false ? ' checked' : '' %>></label>
      <label class="time-row" for="morning">Morning time<input id="morning" name="morning" type="time" required value="<%= user.notify.morning || '08:00' %>"></label>
      <p class="hint">For reminders without a time and for all-day events. How early each event notifies is set on the event.</p>
      <% if (household.features.info !== false) { const wn = user.notify; %>
        <input type="hidden" name="infoForm" value="1">
        <h3 class="sub-h">Home info</h3>
        <div class="check-row">
          <label for="warranty" class="grow">Before an appliance warranty ends</label>
          <select name="warrantyDays" aria-label="How early"><% [7, 14, 30, 60, 90].forEach((d) => { %><option value="<%= d %>"<%= (wn.warrantyDays ?? 30) === d ? ' selected' : '' %>><%= d %> days</option><% }) %></select>
          <input id="warranty" type="checkbox" name="warranty"<%= wn.warranty !== false ? ' checked' : '' %>>
        </div>
        <p class="hint">Uses the “Warranty ends” date on items in Home info.</p>
      <% } %>
      <% if (household.features.pantry !== false) { const pn = user.notify; %>
        <input type="hidden" name="pantryForm" value="1">
        <h3 class="sub-h">Pantry</h3>
        <div class="check-row">
          <label for="pantryExpiry" class="grow">When something’s about to expire</label>
          <select name="pantryExpiryDays" aria-label="How early"><% [[0, 'On the day'], [1, '1 day before'], [2, '2 days before'], [3, '3 days before'], [5, '5 days before'], [7, '7 days before']].forEach(([d, l]) => { %><option value="<%= d %>"<%= (pn.pantryExpiryDays ?? 2) === d ? ' selected' : '' %>><%= l %></option><% }) %></select>
          <input id="pantryExpiry" type="checkbox" name="pantryExpiry"<%= pn.pantryExpiry !== false ? ' checked' : '' %>>
        </div>
      <% } %>
      <% if (household.features.bills !== false) { const n = user.notify; %>
        <input type="hidden" name="billsForm" value="1">
        <h3 class="sub-h">Bills</h3>
        <div class="check-row">
          <label for="billsBefore" class="grow">Before a bill is due</label>
          <select name="billsBeforeDays" aria-label="How many days before"><% [1, 2, 3, 5, 7, 14].forEach((d) => { %><option value="<%= d %>"<%= n.billsBeforeDays === d ? ' selected' : '' %>><%= d %> <%= d === 1 ? 'day' : 'days' %></option><% }) %></select>
          <input id="billsBefore" type="checkbox" name="billsBefore"<%= n.billsBefore !== false ? ' checked' : '' %>>
        </div>
        <label class="check-row">On the due date<input type="checkbox" name="billsDue"<%= n.billsDue !== false ? ' checked' : '' %>></label>
        <label class="check-row">When a bill is overdue<input type="checkbox" name="billsOverdue"<%= n.billsOverdue !== false ? ' checked' : '' %>></label>
        <label class="check-row">When someone pays a bill I share (my part)<input type="checkbox" name="billsPaid"<%= n.billsPaid !== false ? ' checked' : '' %>></label>
        <label class="check-row">When someone pays me back<input type="checkbox" name="billsPaidBack"<%= n.billsPaidBack !== false ? ' checked' : '' %>></label>
        <label class="check-row">Sunday reminder of what I owe<input type="checkbox" name="billsWeekly"<%= n.billsWeekly ? ' checked' : '' %>></label>
        <p class="hint">Due-date notifications only go to the people sharing the bill, at your morning time, and stop once it’s paid.</p>
      <% } %>
      <button class="btn btn-ghost" type="submit">Save notification settings</button>
    </form>
  </section>

  <section class="card" id="household" aria-labelledby="hh">
    <div class="row-h"><h2 id="hh"><%= household.name %></h2><a class="link-btn" href="/households"><%= homes.length > 1 ? 'Switch households' : 'Households' %></a></div>
    <% if (link) { %>
      <div class="link-box" role="status">
        <strong><%= link.kind === 'invite' ? 'Invite link' : 'Password reset link' %><%= link.label ? ' for ' + link.label : '' %></strong>
        <input type="text" readonly value="<%= link.url %>" aria-label="Link" data-link-input>
        <div class="btn-row">
          <button class="btn btn-ghost" type="button" data-share-link="<%= link.url %>">Share</button>
          <button class="btn btn-ghost" type="button" data-copy-link="<%= link.url %>">Copy</button>
        </div>
        <p class="small">Works once, for <%= link.days %>. This is the only time it's shown, so send it now.</p>
      </div>
    <% } %>
    <% members.forEach((m) => { %>
      <div class="row">
        <span class="avatar" aria-hidden="true"><%= m.name.charAt(0).toUpperCase() %></span>
        <div class="row-body"><span class="row-title"><%= m.name %></span><span class="row-meta"><%= m.email %> · <%= m.role === 'admin' ? 'Admin' : 'Member' %><%= m.disabled ? ' · Turned off' : '' %></span></div>
        <% if (member.role === 'admin' && String(m._id) !== user.id) { %><a class="link-btn" href="/settings/household/members/<%= m._id %>">Manage<span class="sr-only"> <%= m.name %></span></a><% } %>
      </div>
    <% }) %>
    <% if (member.role === 'admin') { %>
      <% invites.forEach((inv) => { %>
        <div class="row">
          <div class="row-body"><span class="row-title"><%= inv.label || 'Unnamed invite' %></span><span class="row-meta">Waiting to be used</span></div>
          <form method="post" action="/settings/household/invites/<%= inv._id %>/revoke"><button class="link-btn" type="submit">Cancel<span class="sr-only"> invite<%= inv.label ? ' for ' + inv.label : '' %></span></button></form>
        </div>
      <% }) %>
      <form class="stack" method="post" action="/settings/household/invites">
        <div class="field"><label for="inviteLabel">Who's it for? <span class="muted">(optional)</span></label><input id="inviteLabel" name="label" type="text" maxlength="40" placeholder="e.g. Mom"></div>
        <button class="btn btn-primary" type="submit">Create invite link</button>
      </form>
    <% } %>
  </section>

  <% if (member.role === 'admin') { %>
    <form class="card" method="post" action="/settings/sections">
      <h2>Sections</h2>
      <p class="row-meta">Turning a section off hides it for the household and keeps its data.</p>
      <% sections.forEach((s) => { %><label class="check-row"><%= s.label %><input type="checkbox" name="sections" value="<%= s.key %>"<%= household.features[s.key] !== false ? ' checked' : '' %>></label><% }) %>
      <button class="btn btn-ghost" type="submit">Save sections</button>
    </form>
  <% } %>

  <section class="card" aria-labelledby="custom">
    <h2 id="custom">Customize</h2>
    <a class="btn btn-ghost" href="/customize">Customize Today</a>
    <a class="btn btn-ghost" href="/settings/lists">Lists and categories</a>
  </section>

  <form class="card" method="post" action="/settings/pins">
    <h2>Bottom bar</h2>
    <p class="row-meta">Pin up to <%= maxPins %> sections. Everything else stays under More. This only changes your view.</p>
    <% pinOptions.forEach((s) => { %><label class="check-row"><%= s.label %><input type="checkbox" name="pins" value="<%= s.key %>"<%= member.pins.includes(s.key) ? ' checked' : '' %>></label><% }) %>
    <button class="btn btn-ghost" type="submit">Save bottom bar</button>
  </form>

  <form class="card" method="post" action="/settings/appearance">
    <h2>Appearance</h2>
    <div class="radio-row">
      <% [['system', 'Device'], ['light', 'Light'], ['dark', 'Dark']].forEach(([v, label]) => { %><label><input type="radio" name="theme" value="<%= v %>"<%= user.theme === v ? ' checked' : '' %>><%= label %></label><% }) %>
    </div>
    <button class="btn btn-ghost" type="submit">Save appearance</button>
  </form>
</main>
<%- include('partials/bottom') %>
