<%- include('partials/top', { title: 'Settings' }) %>
<main class="stack">
  <h1>Settings</h1>
  <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
  <% const ICONS = {
    bell: 'M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0',
    sun: 'M12 4V2M12 22v-2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
    contrast: 'M12 3a9 9 0 1 0 0 18zM12 3a9 9 0 0 1 0 18',
    bar: 'M3 5h18v14H3zM3 15h18',
    house: 'M3 11l9-8 9 8M5 10v10h14V10',
    people: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 12 0v1M16 3.1a4 4 0 0 1 0 7.8M22 21v-1a6 6 0 0 0-4-5.7',
    list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
    download: 'M12 3v12M7 10l5 5 5-5M4 21h16',
    cal: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4',
  }; %>
  <% const row = (href, title, meta, ico) => { %>
    <a class="row menu-row" href="<%= href %>"><span class="menu-ico" aria-hidden="true"><% if (ICONS[ico]) { %><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="<%= ICONS[ico] %>"></path></svg><% } else { %><%= ico %><% } %></span><span class="row-body"><span class="row-title"><%= title %></span><% if (meta) { %><span class="row-meta"><%= meta %></span><% } %></span><span class="chev" aria-hidden="true">›</span></a>
  <% }; %>

  <section class="settings-group" aria-labelledby="g-you">
    <h2 id="g-you">You</h2>
    <div class="card">
      <% row('/settings/account', 'Account', user.email, user.name.charAt(0).toUpperCase()) %>
      <% row('/settings/notifications', 'Notifications', 'What you’re told about, and when', 'bell') %>
      <% row('/settings/appearance', 'Appearance', { system: 'Matches your device', light: 'Light', dark: 'Dark' }[user.theme || 'system'], 'contrast') %>
      <% row('/settings/bottom-bar', 'Bottom bar', 'Which sections are one tap away', 'bar') %>
      <% row('/customize', 'Today', 'What shows on Today, and in what order', 'sun') %>
      <% row('/settings/calendar', 'Calendar feed', 'See Nestly in Google or Apple Calendar', 'cal') %>
      <% row('/households', 'Households', homes.length > 1 ? 'You’re in ' + homes.length + ': switch, start, or leave' : 'Start one, or join with an invite', 'house') %>
    </div>
  </section>

  <section class="settings-group" aria-labelledby="g-home">
    <h2 id="g-home"><%= household.name %></h2>
    <div class="card">
      <% row('/settings/people', 'People', isAdmin ? 'Invites, roles, and permissions' : perms.invite ? 'Who’s here, and invites' : 'Who’s in this household', 'people') %>
      <% if (isAdmin) { row('/settings/sections', 'Sections', 'Turn sections on or off, and rename them', 'list') } %>
      <% if (canSettings && sectionRows.length) { row('/settings/defaults', 'Defaults', 'What new items start with', 'list') } %>
      <% if (isAdmin) { row('/settings/export', 'Download data', 'A copy of everything in ' + household.name, 'download') } %>
      <% if (isAdmin) { row('/settings/activity', 'Activity', 'Download, clear, or auto-clear old history', 'list') } %>
    </div>
  </section>

  <% if (canSettings && sectionRows.length) { %>
    <section class="settings-group" aria-labelledby="g-sec">
      <h2 id="g-sec">Sections</h2>
      <div class="card">
        <% sectionRows.forEach((s) => { %>
          <a class="row menu-row" href="/settings/s/<%= s.key %>"><span class="menu-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="<%= s.icon %>"></path></svg></span><span class="row-body row-title"><%= secName(s.key) %></span><span class="chev" aria-hidden="true">›</span></a>
        <% }) %>
      </div>
      <p class="hint">These apply to everyone in <%= household.name %>.</p>
    </section>
  <% } %>
</main>
<%- include('partials/bottom') %>
