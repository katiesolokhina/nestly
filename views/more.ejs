<%- include('partials/top', { title: 'More' }) %>
<main class="stack">
  <h1>More</h1>
  <div class="card">
    <% links.forEach((l) => { %><a class="more-link" href="<%= l.href %>"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= l.icon %>"></path></svg><%= l.label %></a>
    <% }) %>
  </div>
</main>
<%- include('partials/bottom') %>
