<%- include('../partials/top', { title: 'Pantry', scripts: ['swipe', 'scan', 'confirm', 'pantry-select', 'pantry-find'] }) %>
<main class="stack">
  <div class="head">
    <div><h1><%= secName('pantry') %></h1><p class="sub"><%= lowCount %> <%= STATUS.low.toLowerCase() %> or <%= STATUS.out.toLowerCase() %><%= soonCount ? ' · ' + soonCount + ' expiring soon' : '' %></p></div>
    <div class="head-actions">
      <% if (!selecting && (can('pantry', 'add') || can('pantry', 'stock'))) { %><button class="icon-btn" type="button" data-scan-open hidden aria-label="Scan a barcode"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 7V4h3M21 7V4h-3M3 17v3h3M21 17v3h-3M7 8v8M10 8v8M13 8v8M17 8v8"></path></svg></button><% } %>
      <details class="more-menu">
        <summary class="icon-btn" aria-label="More"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="19" cy="12" r="2"></circle></svg></summary>
        <div class="menu-pop">
          <% if (can('pantry', 'add')) { %><a href="/s/pantry/add<%= spot ? '?spot=' + encodeURIComponent(spot) : '' %>">Add with all the details</a><% } %>
          <% if (canBulk && groups.length && !selecting) { %><a href="/s/pantry?<%= query ? query + '&' : '' %>select=1">Select to change several</a><% } %>
          <% if (putAway.length) { %><a href="#putaway">Put away (<%= putAway.length %> waiting)</a><% } %>
          <% if (canSettings) { %><a href="/settings/s/pantry"><%= secName('pantry') %> settings</a><% } %>
        </div>
      </details>
    </div>
  </div>
  <%- include('../partials/rate-prompt', { back: '/s/pantry' }) %>
  <% if (!selecting) { %>
  <form class="find-box" method="get" action="/s/pantry" role="search">
    <% if (show) { %><input type="hidden" name="show" value="<%= show %>"><% } %><% if (spot) { %><input type="hidden" name="spot" value="<%= spot %>"><% } %><% tags.forEach((t) => { %><input type="hidden" name="tag" value="<%= t %>"><% }) %>
    <label class="sr-only" for="find"><%= can('pantry', 'add') ? 'Find or add' : 'Find' %></label>
    <input id="find" name="q" type="search" maxlength="80" value="<%= q %>" placeholder="<%= can('pantry', 'add') ? 'Find or add…' : 'Find…' %>" autocomplete="off" data-pantry-find>
  </form>
  <% const exact = q && groups.some((g) => g.items.some((i) => i.name.toLowerCase() === q.toLowerCase())); %>
  <% if (can('pantry', 'add')) { %><a class="find-add" href="/s/pantry/add?name=<%= encodeURIComponent(q) %><%= spot ? '&spot=' + encodeURIComponent(spot) : '' %>" data-find-add<%= q && !exact && !qTag ? '' : ' hidden' %>><span>+ Add “<span data-find-name><%= q %></span>”</span><span class="muted">opens the full form</span></a><% } %>
  <p class="hint" data-find-tag<%= qTag ? '' : ' hidden' %>>Also showing everything tagged <strong data-find-tag-name><%= qTag %></strong></p>
  <% } %>
  <% if (putAway.length) { %>
    <section class="card" id="putaway" aria-labelledby="pa">
      <h2 id="pa">Put away</h2>
      <p class="row-meta">Bought on Shopping. Put away adds it with its date; Skip adds it without details. Always skips the details for that item from now on.</p>
      <% putAway.forEach((s) => { %>
        <div class="row">
          <div class="row-body"><span class="row-title"><%= s.name %></span><span class="row-meta"><%= s.meta %></span></div>
          <form method="post" action="/s/pantry/putaway/<%= s._id %>/always"><button class="link-btn" type="submit">Always<span class="sr-only"> skip details for <%= s.name %></span></button></form>
          <form method="post" action="/s/pantry/putaway/<%= s._id %>/skip"><button class="link-btn" type="submit">Skip<span class="sr-only"> <%= s.name %></span></button></form>
          <a class="btn btn-primary" href="/s/pantry/add?from=<%= s._id %>">Put away<span class="sr-only"> <%= s.name %></span></a>
        </div>
      <% }) %>
      <% if (putAway.length > 1) { %><form method="post" action="/s/pantry/putaway/skip-all" data-confirm="Add all <%= putAway.length %> to the pantry without dates?"><button class="link-btn" type="submit">Skip details for all <%= putAway.length %></button></form><% } %>
    </section>
  <% } %>
  <% const nFilters = (spot ? 1 : 0) + tags.length; %>
  <div class="filter-wrap">
  <div class="chips filter-row" role="group" aria-label="Show">
    <details class="filter-pop">
      <summary class="chip<%= nFilters ? ' on' : '' %>">Filter<%= nFilters ? ' · ' + nFilters : '' %> ▾</summary>
      <div class="filter-panel card">
        <p class="aisle">Where</p>
        <div class="chips"><% [...household.pantrySpots, 'Other'].forEach((s) => { %><a class="chip<%= spot === s ? ' on' : '' %>" href="<%= urlWith({ spot: spot === s ? '' : s }) %>" aria-pressed="<%= spot === s %>"><%= s %></a><% }) %></div>
        <% if ((household.pantryTags || []).length) { %>
          <p class="aisle">Tags</p>
          <div class="chips"><% household.pantryTags.forEach((t) => { const on = tags.includes(t); %><a class="chip<%= on ? ' on' : '' %>" href="<%= urlWith({ tags: on ? tags.filter((x) => x !== t) : [...tags, t] }) %>" aria-pressed="<%= on %>"><%= t %></a><% }) %></div>
        <% } %>
        <% if (nFilters) { %><a class="link-btn" href="<%= urlWith({ spot: '', tags: [] }) %>">Clear filters</a><% } %>
      </div>
    </details>
    <% if (spot) { %><a class="chip-x" href="<%= urlWith({ spot: '' }) %>" aria-label="Remove filter <%= spot %>"><%= spot %> ×</a><% } %>
    <% tags.forEach((t) => { %><a class="chip-x" href="<%= urlWith({ tags: tags.filter((x) => x !== t) }) %>" aria-label="Remove filter <%= t %>"><%= t %> ×</a><% }) %>
    <a class="chip<%= !show ? ' on' : '' %>" href="<%= urlWith({ show: '' }) %>"<%- !show ? ' aria-current="true"' : '' %>>All</a>
    <a class="chip<%= show === 'low' ? ' on' : '' %>" href="<%= urlWith({ show: 'low' }) %>"<%- show === 'low' ? ' aria-current="true"' : '' %>><%= STATUS.low %> &amp; <%= STATUS.out.toLowerCase() %><%= lowCount ? ' (' + lowCount + ')' : '' %></a>
    <a class="chip<%= show === 'soon' ? ' on' : '' %>" href="<%= urlWith({ show: 'soon' }) %>"<%- show === 'soon' ? ' aria-current="true"' : '' %>>Expiring<%= soonCount ? ' (' + soonCount + ')' : '' %></a>
  </div>
  </div>
  <% if (selecting) { %>
    <form class="stack" method="post" action="/s/pantry/bulk" data-bulk-form>
      <input type="hidden" name="query" value="<%= query %>">
      <div class="row-h"><h2>Select items</h2><a class="link-btn" href="/s/pantry<%= query ? '?' + query : '' %>">Done</a></div>
      <div class="card">
        <% if (!groups.length) { %><p class="muted small center">Nothing here.</p><% } %>
        <% groups.forEach((g, gi) => { %>
          <div data-bulk-group>
            <div class="row-h"><p class="aisle"><%= g.name %></p><button class="link-btn" type="button" data-bulk-all>Select all here<span class="sr-only"> (<%= g.name %>)</span></button></div>
            <% g.items.forEach((i) => { %>
              <label class="row ing-pick"><input type="checkbox" name="ids" value="<%= i._id %>" data-bulk-item><span class="row-body"><span class="row-title"><%= i.name %></span><% if (i.meta) { %><span class="row-meta"><%= i.meta %></span><% } %><% if ((i.tags || []).length) { %><span class="tag-row"><% i.tags.forEach((t) => { %><span class="tag lilac"><%= t %></span><% }) %></span><% } %></span><span class="tag"><%= STATUS[i.status] %></span></label>
            <% }) %>
          </div>
        <% }) %>
      </div>
      <div class="bulk-bar card">
        <strong data-bulk-count>Tick items, or Select all in a spot</strong>
        <div class="bulk-do">
          <label class="sr-only" for="bulk-do">Change</label>
          <select id="bulk-do" name="do" required>
            <option value="">Change them…</option>
            <optgroup label="Move to"><% [...household.pantrySpots, 'Other'].forEach((sp) => { %><option value="move:<%= sp %>"><%= sp %></option><% }) %></optgroup>
            <optgroup label="Status"><% Object.entries(STATUS).forEach(([v, l]) => { %><option value="status:<%= v %>"><%= l %></option><% }) %></optgroup>
            <% if ((household.pantryTags || []).length) { %>
              <optgroup label="Add tag"><% household.pantryTags.forEach((t) => { %><option value="tag+:<%= t %>">+ <%= t %></option><% }) %></optgroup>
              <optgroup label="Remove tag"><% household.pantryTags.forEach((t) => { %><option value="tag-:<%= t %>">− <%= t %></option><% }) %></optgroup>
            <% } %>
            <optgroup label="Food (for recipes)"><option value="food:yes">Food</option><option value="food:no">Not food</option><option value="food:auto">By where it’s kept</option></optgroup>
            <optgroup label="Add to shopping when low"><option value="shop:on">On</option><option value="shop:off">Off</option></optgroup>
          </select>
          <button class="btn btn-primary" type="submit" data-bulk-apply>Apply</button>
        </div>
        <% if (can('pantry', 'delete') && (perms.parts('pantry') || {}).delete === 'all') { %><button class="btn btn-danger btn-block" type="submit" name="do" value="delete" formnovalidate data-bulk-delete data-confirm="Remove the selected items from the pantry? You can undo it from Activity.">Delete selected</button><% } %>
      </div>
    </form>
  <% } else { %>
  <div class="stack spot-cards" data-find-card>
    <p class="card muted small center" data-find-none hidden>Nothing here matches.</p><% if (!groups.length) { %><p class="card muted small center"><%= show || spot || q || tags.length ? 'Nothing here matches.' : 'Nothing in the pantry yet. Add what you keep at home.' %></p><% } %>
    <% groups.forEach((g) => { %>
      <section class="card spot-card" data-find-group aria-label="<%= g.name %>">
        <p class="aisle"><%= g.name %></p>
        <% g.items.forEach((i) => { %>
          <div class="swipe" data-swipe id="p-<%= i._id %>" data-find-row data-name="<%= i.name.toLowerCase() %>" data-tags="<%= (i.tags || []).join('|').toLowerCase() %>">
            <% if (can('pantry', 'delete', i)) { %><form class="swipe-delete" method="post" action="/s/pantry/<%= i._id %>/delete"><input type="hidden" name="query" value="<%= query %>"><button type="submit" tabindex="-1">Delete<span class="sr-only"> <%= i.name %></span></button></form><% } %>
            <div class="row pantry-row status-<%= i.status %>">
              <% if (i.photoId) { %><a class="pantry-thumb" href="/files/<%= i.photoId %>/view?back=/s/pantry"><img src="/files/<%= i.photoId %>" alt="Photo of <%= i.name %>" loading="lazy"></a><% } %>
              <% if (can('pantry', 'edit', i)) { %><a class="row-body row-link" href="/s/pantry/<%= i._id %>/edit"><span class="row-title"><%= i.name %></span><% if (i.meta) { %><span class="row-meta<%= i.exp.tone === 'late' ? ' late' : '' %>"><%= i.meta %></span><% } %><% if ((i.tags || []).length) { %><span class="tag-row"><% i.tags.forEach((t) => { %><span class="tag lilac"><%= t %></span><% }) %></span><% } %></a><% } else { %><div class="row-body"><span class="row-title"><%= i.name %></span><% if (i.meta) { %><span class="row-meta<%= i.exp.tone === 'late' ? ' late' : '' %>"><%= i.meta %></span><% } %><% if ((i.tags || []).length) { %><span class="tag-row"><% i.tags.forEach((t) => { %><span class="tag lilac"><%= t %></span><% }) %></span><% } %></div><% } %>
              <% if (i.count > 1 && can('pantry', 'stock')) { %><form method="post" action="/s/pantry/<%= i._id %>/use"><input type="hidden" name="query" value="<%= query %>"><button class="mini use-one" type="submit" aria-label="Used one <%= i.name %> (<%= i.count %> left)">−1</button></form><% } %>
              <% if (!can('pantry', 'stock')) { %><span class="tag"><%= STATUS[i.status] %></span><% } else { %><form class="status-seg" method="post" action="/s/pantry/<%= i._id %>/status" aria-label="<%= i.name %>: <%= STATUS[i.status] %>">
                <input type="hidden" name="query" value="<%= query %>">
                <% Object.entries(STATUS).forEach(([v, l]) => { %><button type="submit" name="status" value="<%= v %>" class="seg-<%= v %><%= i.status === v ? ' on' : '' %>" aria-pressed="<%= i.status === v %>"><%= l %><span class="sr-only"> <%= i.name %></span></button><% }) %>
              </form><% } %>
            </div>
          </div>
        <% }) %>
      </section>
    <% }) %>
  </div>
  <% } %>
  <p class="hint"><% if (shoppingOn) { %>Marking something <%= household.pantryShop === 'out' ? STATUS.out : STATUS.low + ' or ' + STATUS.out %> puts it on the shopping list, and what’s bought there waits under Put away. <% } %>Swipe an item left to delete it.</p>
</main>
<% if (can('pantry', 'add') || can('pantry', 'stock')) { %><%- include('../partials/scanner', { mode: 'pantry', spots: household.pantrySpots, spot: spot || defaultSpot || household.pantrySpots[0], query }) %><% } %>
<%- include('../partials/bottom') %>
