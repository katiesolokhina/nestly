<%- include('../partials/top', { title: item._id ? 'Edit pantry item' : 'Add to pantry', scripts: ['confirm', 'pantry-dates'] }) %>
<main class="stack">
  <div class="head"><h1><%= item._id ? 'Edit pantry item' : 'Add to pantry' %></h1><a class="link-btn" href="/s/pantry">Cancel</a></div>
  <form class="card" method="post" action="/s/pantry<%= item._id ? '/' + item._id : '' %>" enctype="multipart/form-data" novalidate>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <div class="field"><label for="name">Item</label><input id="name" name="name" type="text" maxlength="80" required list="catalog-names" autocomplete="off" value="<%= item.name %>"></div>
    <datalist id="catalog-names"><% catalog.forEach((c) => { %><option value="<%= c.name %>"></option><% }) %></datalist>
    <% if (!item._id && existing.length) { %><%- include('choices', { existing }) %><% } %>
    <div class="fields">
      <div class="field"><label for="spot">Kept in</label><select id="spot" name="spot"><% household.pantrySpots.forEach((s) => { %><option<%= item.spot === s ? ' selected' : '' %>><%= s %></option><% }) %><option<%= item.spot === 'Other' ? ' selected' : '' %>>Other</option></select></div>
      <div class="field"><label for="status">Status</label><select id="status" name="status"><% Object.entries(STATUS).forEach(([v, l]) => { %><option value="<%= v %>"<%= item.status === v ? ' selected' : '' %>><%= l %></option><% }) %></select></div>
    </div>
    <fieldset class="group" data-batches>
      <legend>How many, by use-by date</legend>
      <p class="hint">One line per date. Leave the date blank for things that don’t expire.</p>
      <% const rows = item.status === 'out' ? [] : item.batches; %>
      <% [...rows, { count: '', expires: '', bought: todayDate, fresh: true }].forEach((b, i) => { %>
        <div class="batch-row" data-batch-row>
          <label class="sr-only" for="bc-<%= i %>">How many</label>
          <input id="bc-<%= i %>" class="batch-count" name="bCount" type="number" min="0" max="999" inputmode="numeric" placeholder="#" value="<%= b.count %>">
          <span class="batch-x" aria-hidden="true">×</span>
          <label class="sr-only" for="be-<%= i %>">Use by</label>
          <input id="be-<%= i %>" name="bExpires" type="date" value="<%= b.expires %>">
          <button class="link-btn batch-clear" type="button" data-clear-date hidden>No date</button>
          <span class="batch-bought"><label for="bb-<%= i %>">Bought</label><input id="bb-<%= i %>" name="bBought" type="date" value="<%= b.bought || '' %>" max="<%= todayDate %>"<%- b.fresh ? ` data-default="${todayDate}"` : '' %>><button class="link-btn" type="button" data-clear-date hidden>No date</button></span>
        </div>
      <% }) %>
      <p class="hint">The empty line adds more with another date. Set a count to 0 to remove that line.</p>
    </fieldset>
    <div class="field"><label for="amount">Each one <span class="muted">(optional)</span></label><input id="amount" name="amount" type="text" maxlength="40" placeholder="1 gallon, 16 oz" value="<%= item.amount %>"></div>
    <div class="field">
      <label for="photo">Reference photo <span class="muted">(optional: the brand or size you buy)</span></label>
      <% if (photo) { %><p class="file-row"><a href="/files/<%= photo._id %>/view?back=/s/pantry/<%= item._id %>/edit"><img class="file-thumb" src="/files/<%= photo._id %>" alt="Current photo"></a><label class="inline-check"><input type="checkbox" name="removePhoto">Remove</label></p><% } %>
      <input id="photo" name="photo" type="file" accept="image/*">
    </div>
    <% const spotFood = !(household.nonFoodSpots || []).includes(item.spot); %>
    <div class="field"><label for="food">Food (used for recipes)</label><select id="food" name="food">
      <option value="auto"<%= item.food == null ? ' selected' : '' %>>By where it’s kept (<%= spotFood ? 'yes' : 'no' %>)</option>
      <option value="yes"<%= item.food === true ? ' selected' : '' %>>Yes</option>
      <option value="no"<%= item.food === false ? ' selected' : '' %>>No</option>
    </select><span class="hint">Not-food spots are set in Settings → Pantry.</span></div>
    <label class="check-row">Add to shopping when it’s <%= household.pantryShop === 'out' ? STATUS.out.toLowerCase() : STATUS.low.toLowerCase() + ' or ' + STATUS.out.toLowerCase() %><input type="checkbox" name="autoShop"<%= item.autoShop !== false ? ' checked' : '' %>></label>
    <div class="field"><label for="note">Note <span class="muted">(optional)</span></label><input id="note" name="note" type="text" maxlength="300" placeholder="Brand we like, top shelf…" value="<%= item.note %>"></div>
    <button class="btn btn-primary btn-block" type="submit">Save</button>
  </form>
  <% if (item._id) { %>
    <p class="hint">Last changed by <%= item.statusBy || item.byName %>.</p>
    <% if (can('pantry', 'delete', item)) { %><form method="post" action="/s/pantry/<%= item._id %>/delete"><button class="link-btn link-danger" type="submit">Remove from the pantry<span class="sr-only"> <%= item.name %></span></button></form><% } %>
  <% } %>
</main>
<%- include('../partials/bottom') %>
