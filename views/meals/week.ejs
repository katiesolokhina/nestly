<%- include('../partials/top', { title: 'Meals' }) %>
<main class="stack">
  <div class="head"><div><h1 class="title-gear"><%= secName('meals') %><%- include('../partials/gear', { key: 'meals' }) %></h1><p class="sub"><%= count %> planned · <%= range %></p></div><% if (canEdit('meals')) { %><a class="btn btn-primary" href="/s/meals/new?date=<%= isThisWeek ? '' : start %>">Add</a><% } %></div>
  <div class="card">
    <div class="row-h">
      <a class="icon-link" href="/s/meals?week=<%= prev %>" aria-label="Previous week">‹</a>
      <h2 class="month-title"><%= title %></h2>
      <a class="icon-link" href="/s/meals?week=<%= next %>" aria-label="Next week">›</a>
    </div>
    <div class="btn-row">
      <% if (!isThisWeek) { %><a class="btn btn-ghost" href="/s/meals">This week</a><% } %>
      <% if (lastWeekCount) { %><form method="post" action="/s/meals/copy-week"><input type="hidden" name="week" value="<%= start %>"><button class="btn btn-ghost" type="submit">Copy the week before</button></form><% } %>
      <% if (shoppingOn && withRecipes) { %><a class="btn btn-ghost" href="/s/shopping/ingredients?week=<%= start %>">Add ingredients to shopping</a><% } %>
    </div>
  </div>
  <% if (suggest) { %>
    <section class="card" aria-labelledby="usesoon">
      <h2 id="usesoon">Use soon</h2>
      <% if (suggest.soon.length) { %>
        <p class="row-meta"><%= suggest.soon.map((i) => i.name + ' (' + i.expText.toLowerCase() + ')').join(', ') %></p>
        <% if (!suggest.recipes.length) { %><p class="muted small">None of your recipes use these yet. <a href="/s/recipes/cook">Find ideas</a>.</p><% } %>
      <% } else { %>
        <p class="row-meta">Nothing in the pantry has a use-by date this week<%= suggest.hasPantry ? '' : ' (the pantry is empty)' %>.<%= suggest.recipes.length ? ' You have most of what these need:' : '' %></p>
        <% if (!suggest.recipes.length) { %><p class="muted small"><%= suggest.hasRecipes ? 'None of your recipes match what’s in the pantry.' : 'Save a few recipes and they’ll show up here.' %> <a href="/s/recipes/cook">Find ideas</a>.</p><% } %>
      <% } %>
      <% suggest.recipes.forEach((m, n) => { %>
        <form class="plan-row" method="post" action="/s/meals">
          <input type="hidden" name="recipeId" value="<%= m.recipe._id %>"><input type="hidden" name="slot" value="<%= suggest.slot %>">
          <a class="row-body row-link" href="/s/recipes/<%= m.recipe._id %>"><span class="row-title"><%= m.recipe.title %></span><span class="row-meta"><%= m.uses.length ? 'Uses ' + m.uses.map((u) => u.name).join(', ') : 'Have ' + m.got + ' of ' + m.total %><%= m.missing.length ? ' · Need ' + m.missing.slice(0, 3).join(', ') + (m.missing.length > 3 ? ' +' + (m.missing.length - 3) : '') : '' %></span></a>
          <label class="sr-only" for="sd-<%= n %>">Day for <%= m.recipe.title %></label>
          <select id="sd-<%= n %>" name="date"><% suggest.days.forEach((d) => { %><option value="<%= d.date %>"><%= d.label %></option><% }) %></select>
          <button class="btn btn-ghost" type="submit">Plan<span class="sr-only"> <%= m.recipe.title %> for <%= suggest.slot.toLowerCase() %></span></button>
        </form>
      <% }) %>
      <p class="hint">Plans it for <%= suggest.slot.toLowerCase() %>. <a href="/s/recipes/cook">More ideas, or search online</a>.</p>
    </section>
  <% } %>
  <% const earlier = days.filter((d) => d.past && isThisWeek); const shown = days.filter((d) => !(d.past && isThisWeek)); %>
  <% const dayCard = (d) => { %>
    <section class="card meal-day<%= d.today ? ' is-today' : '' %><%= d.past ? ' is-past' : '' %>" id="d-<%= d.date %>" aria-labelledby="h-<%= d.date %>">
      <h2 id="h-<%= d.date %>"><%= d.label %><% if (d.today) { %> <span class="tag lilac">Today</span><% } %></h2>
      <% d.slots.forEach((s) => { %>
        <% if (!s.meals.length) { %>
          <div class="row meal-row"><span class="meal-slot"><%= s.slot %></span><a class="row-body row-link muted small" href="/s/meals/new?date=<%= d.date %>&slot=<%= encodeURIComponent(s.slot) %>">+ Add<span class="sr-only"> <%= s.slot %> on <%= d.label %></span></a></div>
        <% } %>
        <% s.meals.forEach((m, i) => { %>
          <div class="row meal-row">
            <span class="meal-slot"><%= i === 0 ? s.slot : '' %></span>
            <% const meta = [m.servings ? 'Serves ' + m.servings : '', m.note].filter(Boolean).join(' · '); %><a class="row-body row-link" href="<%= m.hasRecipe ? '/s/recipes/' + m.recipeId + (m.servings ? '?serves=' + m.servings : '') : '/s/meals/' + m._id + '/edit' %>"><span class="row-title"><%= m.name %></span><% if (meta) { %><span class="row-meta"><%= meta %></span><% } %></a>
            <a class="link-btn" href="/s/meals/<%= m._id %>/edit">Change<span class="sr-only"> <%= m.name %>, <%= s.slot %> on <%= d.label %></span></a>
          </div>
        <% }) %>
      <% }) %>
    </section>
  <% }; %>
  <% if (earlier.length) { %>
    <details class="card earlier">
      <summary>Earlier this week (<%= earlier.length %> <%= earlier.length === 1 ? 'day' : 'days' %>)</summary>
      <% earlier.forEach(dayCard) %>
    </details>
  <% } %>
  <% shown.forEach(dayCard) %>
  <p class="hint">Use the arrows to look back at past weeks. Meal slots can be changed in Settings, Lists and categories.</p>
</main>
<%- include('../partials/bottom') %>
