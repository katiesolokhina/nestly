<%- include('../partials/top', { title: list.title, scripts: ['confirm', 'list-drag', 'auto-submit'] }) %>
<main class="stack">
  <div class="head">
    <div><a class="back-link" href="/s/lists">‹ Back</a><h1><%= list.title %></h1><p class="muted small"><%= T.label %><%= list.type === 'wishlist' && list.ownerName ? ' · ' + list.ownerName + '’s' : '' %><%= list.private ? ' · Only me' : '' %></p>
      <% if (list.type === 'packing' && list.date) { %><p class="sub"><%= tripText %></p><% } %></div>
    <% if (canEdit('lists')) { %><a class="btn btn-ghost" href="/s/lists/<%= list._id %>/edit">Edit</a><% } %>
  </div>

  <% if (list.type === 'note') { %>
    <section class="card"><% if (list.body) { %><p class="pre-wrap"><%= list.body %></p><% } else { %><p class="muted small center">Empty. Tap Edit to write.</p><% } %></section>
  <% } else { %>
    <% if (list.type === 'wishlist' && isOwner) { %><p class="hint">Others can see this and mark what they’re getting. You won’t see who’s getting what.</p><% } %>
    <% if (list.items.length > 6 || q) { %>
      <div class="search-row">
        <form method="get" action="/s/lists/<%= list._id %>" role="search" class="grow"><input type="search" name="q" value="<%= q %>" placeholder="Search this list" aria-label="Search this list"></form>
        <form method="post" action="/s/lists/<%= list._id %>/sort" data-auto-submit><select name="sort" aria-label="Order"><% sorts.forEach(([k, label]) => { %><option value="<%= k %>"<%= sort === k ? ' selected' : '' %>><%= label %></option><% }) %></select><noscript><button class="btn btn-ghost" type="submit">Sort</button></noscript></form>
      </div>
    <% } else if (sorts.length > 3 && list.items.length > 1) { %>
      <form class="search-row" method="post" action="/s/lists/<%= list._id %>/sort" data-auto-submit><select name="sort" aria-label="Order"><% sorts.forEach(([k, label]) => { %><option value="<%= k %>"<%= sort === k ? ' selected' : '' %>><%= label %></option><% }) %></select><noscript><button class="btn btn-ghost" type="submit">Sort</button></noscript></form>
    <% } %>
    <section class="card">
      <h2 class="small-h"><%= T.undone %> <span class="muted">· <%= open.length %></span></h2>
      <% if (canEdit('lists')) { %>
        <form class="add" id="add" method="post" action="/s/lists/<%= list._id %>/items">
          <textarea name="text" rows="1" maxlength="8000" aria-label="<%= T.add %>" placeholder="<%= T.add %><%= ['packing', 'checklist'].includes(list.type) ? ': one, two, three' : '' %>" data-grow></textarea>
          <button class="btn btn-primary" type="submit">Add</button>
        </form>
      <% } %>
      <% if (!open.length) { %><p class="muted small center"><%= done.length ? 'All ' + T.done.toLowerCase() + '!' : 'Nothing yet.' %></p><% } %>
      <% open.forEach((i) => { %><%- include('row', { i }) %><% }) %>
    </section>
    <% if (later.length) { %>
      <section class="card">
        <h2 class="small-h">Over or out of season <span class="muted">· <%= later.length %></span></h2>
        <% later.forEach((i) => { %><%- include('row', { i }) %><% }) %>
      </section>
    <% } %>
    <% if (done.length) { %>
      <section class="card">
        <div class="row-h"><h2 class="small-h"><%= T.done %> <span class="muted">· <%= done.length %></span></h2>
          <% if (!showDone) { %><a class="link-btn" href="?done=1">Show</a><% } else if (canEdit('lists') && list.type !== 'packing') { %><form method="post" action="/s/lists/<%= list._id %>/clear-done" data-confirm="Remove the <%= done.length %> <%= T.done.toLowerCase() %> from the list?"><button class="link-btn" type="submit">Clear</button></form><% } %></div>
        <% if (showDone) { done.forEach((i) => { %><%- include('row', { i }) %><% }) } %>
      </section>
    <% } %>
  <% } %>

  <% if (canEdit('lists')) { %>
    <div class="btn-row wrap">
      <% if (list.type === 'packing') { %>
        <% if (done.length) { %><form method="post" action="/s/lists/<%= list._id %>/reset" data-confirm="Untick everything for the next trip?"><button class="btn btn-ghost" type="submit">Untick all</button></form><% } %>
        <form method="post" action="/s/lists/<%= list._id %>/copy"><button class="btn btn-ghost" type="submit">Copy for a new trip</button></form>
        <% if (trip) { %><a class="btn btn-ghost" href="<%= trip %>">Add trip to calendar</a><% } %>
      <% } else if (list.type !== 'note') { %>
        <form method="post" action="/s/lists/<%= list._id %>/copy"><button class="btn btn-ghost" type="submit">Copy list</button></form>
      <% } %>
    </div>
  <% } %>
</main>
<%- include('../partials/bottom') %>
