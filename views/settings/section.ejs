<%- include('../partials/top', { title: title + ' settings', scripts: ['color-submit', 'rows', 'list-drag', 'confirm'] }) %>
<main class="stack">
  <%- include('../partials/settings-head', { heading: title, sub: 'For everyone in ' + household.name + '.', back }) %>
  <% const sel = (name, options, value, label) => { %>
    <label class="time-row" for="f-<%= name %>"><%= label %><select id="f-<%= name %>" name="<%= name %>"><% options.forEach(([v, l]) => { %><option value="<%= v %>"<%= String(value) === String(v) ? ' selected' : '' %>><%= l %></option><% }) %></select></label>
  <% }; %>
  <% const weekRow = () => sel('weekStart', [[0, 'Sunday'], [1, 'Monday']], household.weekStart, 'Week starts on'); %>

  <% if (key === 'shopping') { %>
    <a class="card row menu-row" href="/s/shopping/saved"><span class="row-body"><span class="row-title">Saved items and staples</span><span class="row-meta">What shows up as you type, their usual details, and the staple buttons</span></span><span class="chev" aria-hidden="true">›</span></a>
  <% } %>
  <% if (key !== 'recipes' && key !== 'info' && key !== 'lists') { %>
  <form class="card stack" method="post" action="/settings/s/<%= key %><%= back !== '/settings' ? '?from=section' : '' %>">
    <h2>Defaults</h2>
    <p class="hint">What new items start with (store, category, tag…) is in <a href="/settings/defaults">Settings → Defaults</a>.</p>
    <% if (key === 'shopping') { %>
      <label class="check-row">Tell everyone when someone starts shopping<input type="checkbox" name="tripAlerts"<%= household.tripAlerts !== false ? ' checked' : '' %>></label>
      <% sel('tripGapMin', [[15, '15 minutes'], [30, '30 minutes'], [60, '1 hour'], [120, '2 hours']], household.tripGapMin, 'At most once every') %>
      <p class="hint">Each person can still turn shopping alerts off for themselves in Notifications.</p>
    <% } else if (key === 'remember') { %>
      <% sel('remNotify', [['all', 'Everyone'], ['me', 'Just whoever adds it'], ['none', 'No one']], household.remNotify, 'New reminders notify') %>
    <% } else if (key === 'calendar') { %>
      <% weekRow() %>
      <% sel('eventAlert', alertChoices.filter((c) => c.kind === 'timed' || c.value === 'none').map((c) => [c.value, c.label]), household.eventAlert, 'Events with a time notify') %>
      <% sel('eventAlertAllDay', alertChoices.filter((c) => c.kind === 'allday' || c.value === 'none').map((c) => [c.value, c.label]), household.eventAlertAllDay, 'All-day events notify') %>
      <p class="hint">These are what a new event starts with. Each event can still be changed.</p>
    <% } else if (key === 'meals') { %>
      <% weekRow() %>
      <p class="hint">The week start is shared with the Calendar.</p>
    <% } else if (key === 'pantry') { %>
      <fieldset class="group">
        <legend>Status names</legend>
        <div class="fields">
          <div class="field"><label for="nameHave">Plenty</label><input id="nameHave" name="nameHave" type="text" maxlength="16" value="<%= names.have %>"></div>
          <div class="field"><label for="nameLow">Running low</label><input id="nameLow" name="nameLow" type="text" maxlength="16" value="<%= names.low %>"></div>
          <div class="field"><label for="nameOut">None left</label><input id="nameOut" name="nameOut" type="text" maxlength="16" value="<%= names.out %>"></div>
        </div>
      </fieldset>
      <% sel('pantryShop', [['both', names.low + ' or ' + names.out], ['out', names.out + ' only'], ['never', 'Never']], household.pantryShop, 'Add to shopping when') %>
      <% sel('pantrySoonDays', [[1, '1 day'], [2, '2 days'], [3, '3 days'], [5, '5 days'], [7, '7 days'], [14, '14 days']], household.pantrySoonDays, '“Expiring soon” means within') %>
      <a class="card row menu-row" href="/settings/ratings"><span class="row-body"><span class="row-title">Ratings</span><span class="row-meta">Buy again, Never again… and the “Buy again?” prompt</span></span><span class="chev" aria-hidden="true">›</span></a>
      <fieldset class="group" id="nonfood">
        <legend>Not food</legend>
        <p class="hint">Things kept here are left out of recipes, What can I cook, and Use soon. Each item can override this.</p>
        <input type="hidden" name="nonFoodShown" value="1">
        <% household.pantrySpots.forEach((s) => { %><label class="check-row"><%= s %><input type="checkbox" name="nonFood" value="<%= s %>"<%= (household.nonFoodSpots || []).includes(s) ? ' checked' : '' %>></label><% }) %>
      </fieldset>
      <fieldset class="group" id="aisles">
        <legend>Where bought things are kept</legend>
        <p class="hint">By shopping aisle. Used when something bought is put away, or skipped into the pantry.</p>
        <% pantry.aisles.forEach((a, i) => { %>
          <label class="time-row" for="aisleSpot<%= i %>"><%= a.aisle %><select id="aisleSpot<%= i %>" name="aisleSpot<%= i %>"><option value="">Where new items go</option><% household.pantrySpots.forEach((s) => { %><option<%= a.spot === s ? ' selected' : '' %>><%= s %></option><% }) %></select></label>
        <% }) %>
      </fieldset>
    <% } else if (key === 'bills') { %>
      <% sel('billSplit', [['even', 'Evenly with everyone'], ['none', 'Not split']], household.billSplit, 'New bills are split') %>
      <label class="time-row" for="f-currency">Currency symbol<input id="f-currency" name="currency" type="text" maxlength="4" list="currencies" value="<%= household.currency || '$' %>" style="width:5em"></label>
      <datalist id="currencies"><% ['$', '€', '£', '¥', '₹', 'C$', 'A$', '₪', 'R$', 'CHF'].forEach((c) => { %><option value="<%= c %>"></option><% }) %></datalist>
      <% sel('billAheadDays', [[7, '1 week'], [14, '2 weeks'], [31, 'About a month'], [60, 'About 2 months']], household.billAheadDays, 'Repeating bills show up') %>
      <p class="hint">How far before they're due.</p>
    <% } else if (key === 'chores') { %>
      <label class="check-row">Points and rewards<input type="checkbox" name="chorePoints"<%= household.chorePoints ? ' checked' : '' %>></label>
      <p class="hint">Each chore can be worth points. The roles below earn them and spend them on rewards that someone who can change settings says yes to.</p>
      <fieldset class="group">
        <legend>Who earns points</legend>
        <% roleChoices.forEach((r) => { %><label class="check-row"><%= r.name %><input type="checkbox" name="choreEarners" value="<%= r.key %>"<%= (household.choreEarners || []).includes(r.key) ? ' checked' : '' %>></label><% }) %>
      </fieldset>
    <% } %>
    <button class="btn btn-primary btn-block" type="submit">Save</button>
  </form>
  <% } %>

  <% lists.forEach((l) => { %><%- include('../partials/list-editor', { l }) %><% }) %>

  <% if (key === 'chores') { %>
    <section class="card stack" id="rewards" aria-labelledby="rw">
      <h2 id="rw">Rewards</h2>
      <p class="row-meta">What points can be spent on. <%= household.chorePoints ? '' : 'Turn on points above to use them.' %></p>
      <% (household.rewards || []).forEach((r) => { %>
        <div class="row">
          <div class="row-body"><span class="row-title"><%= r.name %></span><span class="row-meta"><%= r.cost %> points</span></div>
          <form method="post" action="/settings/s/chores/rewards/<%= r._id %>/delete"><button class="link-btn link-danger" type="submit">Remove<span class="sr-only"> <%= r.name %></span></button></form>
        </div>
      <% }) %>
      <form class="add" method="post" action="/settings/s/chores/rewards">
        <input type="text" name="name" maxlength="60" aria-label="Reward" placeholder="Pick dinner" required>
        <input type="number" name="cost" min="1" max="100000" inputmode="numeric" aria-label="Points it costs" placeholder="Points" required style="width:6em">
        <button class="btn btn-primary" type="submit">Add</button>
      </form>
    </section>
  <% } %>

  <% if (key === 'info') { %>
    <section class="card stack" aria-labelledby="tpl">
      <h2 id="tpl">Starting fields</h2>
      <p class="row-meta">What a new item of each type starts with. People can still add, rename, or remove fields on any item.</p>
      <% templates.forEach((t) => { %>
        <form class="stack tpl-type" id="tpl-<%= encodeURIComponent(t.type) %>" method="post" action="/settings/s/info<%= back !== '/settings' ? '?from=section' : '' %>" data-rows-form>
          <input type="hidden" name="type" value="<%= t.type %>">
          <h3 class="sub-h"><%= t.type %></h3>
          <div class="info-fields" data-rows>
            <% (t.fields.length ? t.fields : [{ label: '', kind: 'text' }]).forEach((f) => { %>
              <div class="info-field-top" data-row>
                <input class="info-label" name="fLabel" type="text" maxlength="40" placeholder="Field name" aria-label="Field name" value="<%= f.label %>">
                <select class="info-kind" name="fKind" aria-label="Kind of field"><% Object.entries(KINDS).forEach(([k, lab]) => { %><option value="<%= k %>"<%= f.kind === k ? ' selected' : '' %>><%= lab %></option><% }) %></select>
                <button class="mini" type="button" data-row-remove aria-label="Remove this field">×</button>
              </div>
            <% }) %>
          </div>
          <div class="btn-row"><button class="btn btn-ghost" type="button" data-row-add>Add a field</button><button class="btn btn-primary" type="submit">Save <%= t.type %></button></div>
        </form>
      <% }) %>
    </section>
  <% } %>

  <% if (pantry) { %>
    <section class="card stack" id="auto">
      <h2>Skip the details</h2>
      <p class="hint">These go straight into the pantry when bought (as <%= names.have %>, no date), without waiting in Put away. Remove one to be asked again.</p>
      <% if (!pantry.auto.length) { %><p class="muted small">Nothing yet. Tap “Always” on a Put away item, or add one here.</p><% } %>
      <% pantry.auto.forEach((u) => { %>
        <div class="row"><span class="row-body row-title"><%= u.name %></span><form method="post" action="/settings/lists/auto-pantry"><input type="hidden" name="key" value="<%= u.key %>"><button class="link-btn link-danger" type="submit">Remove<span class="sr-only"> <%= u.name %></span></button></form></div>
      <% }) %>
      <form class="add" method="post" action="/settings/lists/auto-pantry">
        <input type="hidden" name="action" value="add">
        <input type="text" name="name" list="auto-names" maxlength="80" aria-label="Item to skip the details for" placeholder="Add an item" autocomplete="off" required>
        <button class="btn btn-primary" type="submit">Add</button>
      </form>
      <datalist id="auto-names"><% pantry.catalog.forEach((c) => { %><option value="<%= c.name %>"></option><% }) %></datalist>
    </section>
  <% } %>

  <% if (usual) { %>
    <section class="card" id="usual">
      <h2>Usually have</h2>
      <p class="hint">When meal ingredients go to the shopping list, these start unticked. Remove one to stop skipping it.</p>
      <% if (!usual.length) { %><p class="muted small">Nothing yet.</p><% } %>
      <% usual.forEach((u) => { %>
        <div class="row"><span class="row-body row-title"><%= u.name %></span><form method="post" action="/settings/lists/usually-have"><input type="hidden" name="key" value="<%= u.key %>"><button class="link-btn link-danger" type="submit">Remove<span class="sr-only"> <%= u.name %></span></button></form></div>
      <% }) %>
    </section>
  <% } %>
</main>
<%- include('../partials/bottom') %>
