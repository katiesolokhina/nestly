<%- include('../partials/top', { title: 'Calendar feed', scripts: ['copy'] }) %>
<main class="stack">
  <%- include('../partials/settings-head', { heading: 'Calendar feed', sub: 'See Nestly in Google Calendar, Apple Calendar, or Outlook.', back: '/settings' }) %>
  <% if (link) { %>
    <section class="card stack">
      <h2>Your private link</h2>
      <p class="row-meta">Copy it now: for safety it’s only shown once. Anyone with it can see what’s in the feed.</p>
      <input type="text" readonly value="<%= link %>" aria-label="Calendar feed link">
      <button class="btn btn-primary" type="button" data-copy="<%= link %>" hidden>Copy link</button>
    </section>
    <section class="card stack">
      <h2>Add it to your calendar</h2>
      <p><strong>Google Calendar</strong> (on a computer): Other calendars → <strong>+</strong> → From URL → paste → Add calendar. It shows up on your phone too.</p>
      <p><strong>iPhone</strong>: Settings → Calendar → Accounts → Add Account → Other → Add Subscribed Calendar → paste.</p>
      <p><strong>Outlook</strong>: Add calendar → Subscribe from web → paste.</p>
      <p class="hint">Calendars check for changes on their own schedule: Google every few hours, iPhone as often as you set (Fetch New Data). Changes in Nestly show up then, not right away.</p>
    </section>
  <% } %>
  <form class="card stack" method="post" action="/settings/calendar">
    <h2>What’s in it</h2>
    <% const labels = { events: 'Events', reminders: 'Reminders with a date', bills: 'Bills (unpaid, on their due date)', chores: 'Chores for me or anyone' }; %>
    <% kinds.forEach((k) => { %><label class="check-row"><%= labels[k] %><input type="checkbox" name="<%= k %>"<%= feed[k] !== false ? ' checked' : '' %>></label><% }) %>
    <p class="hint">Just your view of <%= household.name %>: your “Only me” items, and nothing your role hides.</p>
    <% if (on) { %>
      <button class="btn btn-primary btn-block" type="submit" name="action" value="save">Save</button>
      <button class="btn btn-ghost btn-block" type="submit" name="action" value="new">Make a new link</button>
      <p class="hint">A new link stops the old one working. Use it if you lost the link or shared it by mistake, then add the new one to your calendar.</p>
    <% } else { %>
      <button class="btn btn-primary btn-block" type="submit" name="action" value="new">Make my link</button>
    <% } %>
  </form>
  <% if (on) { %><form method="post" action="/settings/calendar"><button class="link-btn link-danger" type="submit" name="action" value="off">Turn off the feed</button></form><% } %>
</main>
<%- include('../partials/bottom') %>
