# Copy to .env and fill in. Never commit .env.

# Use development on your own computer.
NODE_ENV=production

# Pick a port nothing else on the VPS uses.
PORT=3003

# MongoDB connection string, including the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nestly

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Public origin. Requests from any other origin are rejected.
APP_ORIGIN=https://nestly.trisolocreations.com

# Optional: where receipts and photos are stored (default: ./uploads)
# UPLOAD_DIR=/var/lib/nestly/uploads

# Optional: backups (scripts/backup.js)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# Notifications. Generate a new pair for Nestly (don't reuse Questly's):
#   npx web-push generate-vapid-keys
# Leave these out and notifications stay off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: morning emails. Any SMTP account works (IONOS mail, Gmail with an app password, etc).
# Leave SMTP_HOST out and email stays off.
# SMTP_HOST=smtp.ionos.com
# SMTP_PORT=587
# SMTP_USER=nestly@trisolocreations.com
# SMTP_PASS=
# MAIL_FROM="Nestly <nestly@trisolocreations.com>"

# Optional: online recipes in "What can I cook?". With a free Spoonacular key
# (spoonacular.com/food-api, about 50 points a day) searches match several ingredients and a
# craving. Without one, TheMealDB is used (free, smaller, one ingredient at a time).
# SPOONACULAR_KEY=
